    characterSequence: "\u4E3B\u65E8\u5168\u5BB6\u6876\u8F6C\u6298\u540E\u9762\u662F\u4EB2\u7239\u5BF9\u7B56\u6BD4\u95EE\u9898\u9999\u603B\u5206\u7ED3\u6784\u522B\u8FF7\u8DEF\u5E76\u5217\u8981\u5212\u6E05\u8FB9\u754C\u6307\u4EE3\u5F80\u524D\u627E\u8BED\u53E5\u6392\u5E8F\u770B\u9996\u6346\u7ED1\u5173\u8054\u8BCD\u4E0B\u6587\u63A8\u65AD\u5077\u6362\u6807\u515A\u6B63\u80FD\u91CF\u7EC6\u8282\u663E\u5FAE\u955C\u6982\u5FF5\u73B0\u539F\u5F62\u7EDD\u8868\u8FF0\u591A\u534A\u5047\u76F8\u50CF\u597D\u4EBA\u6539\u6210\u9012\u8FDB\u56E0\u679C\u5012\u7F6E\u800D\u6D41\u6C13\u5FC5\u6761\u4EF6\u5F53\u5145\u81A8\u80C0\u53EA\u6709\u624D\u91CC\u85CF\u95E8\u69DB\u5C31\u8F83\u771F\u914D\u5F3A\u8FEB\u75C7\u7136\u800C\u5176\u5B9E\u751A\u81F3\u4E0A\u53F0\u9636\u5C24\u91CD\u70B9\u753B\u5708\u8A00\u4E4B\u540C\u4E49\u66FF\u8BDD\u8BF4\u7248\u5B83\u5230\u5E95\u8C01\u8FD9\u90A3\u6B64\u9F50\u903B\u8F91\u586B\u7A7A\u642D\u56FA\u5B9A\u80CC\u5410\u611F\u60C5\u8272\u5F69\u7A7F\u9519\u8912\u8D2C\u4E92\u4F1A\u793E\u6B7B\u7A0B\u5EA6\u8F7B\u8FC7\u5934\u5E73\u884C\u987F\u53F7\u9017\u4E00\u4E5F\u5728\u671B\u751F\u5751\u5DEE\u610F\u5F88\u6EE1\u4E0D\u520A\u8BBA\u5220\u52A0\u975E\u76EE\u65E0\u725B\u719F\u7EC3\u51B2\u5148\u6328\u5200\u7099\u624B\u53EF\u70ED\u62A2\u4E07\u5DF7\u6D1B\u9633\u7EB8\u8D35\u5199\u5F97\u5927\u6350\u90FD\u7559\u7740\u8C37\u8DB3\u97F3\u96BE\u95FB\u9AD8\u5C71\u6C34\u9047\u77E5\u9CDE\u6B21\u6809\u5EFA\u7B51\u7269\u6C57\u680B\u4E66\u826F\u83A0\u574F\u9C7C\u9F99\u6DF7\u6742\u86C7\u73E0\u4E71\u6EE5\u7AFD\u6570\u961F\u4F0D\u524A\u9002\u5C65\u786C\u51D1\u5408\u7F18\u6728\u6C42\u65B9\u5411\u5357\u8F95\u5317\u8F99\u8D8A\u8D70\u8FDC\u62B1\u85AA\u6551\u706B\u5E2E\u5FD9\u996E\u9E29\u6B62\u6E34\u6025\u660F\u626C\u6C64\u6CB8\u6CBB\u672C\u91DC\u62BD\u6839\u672A\u96E8\u7EF8\u7F2A\u56E4\u7CAE\u6C5F\u5FC3\u8865\u6F0F\u665A\u4E34\u6398\u4E95\u9526\u6DFB\u82B1\u96EA\u4E2D\u9001\u70AD\u670B\u53CB\u78B3\u8E74\u6325\u7AE0\u52B3\u6C38\u9038\u60F3\u592A\u7F8E\u75C5\u4ECB\u6B8B\u7F3A\u4E24\u8138\u7EA2\u5426\u6B67\u7ED5\u53E3\u4EE4\u8D58\u4F59\u52A8\u5F0F\u7CC5\u7F1D\u602A\u4F4D\u626D\u7B26\u620F\u5F15\u5185\u5916\u4FEE\u8F9E\u6CD5\u8BA4\u55BB\u62DF\u5938\u5F20\u5076\u594F\u53CD\u8BBD\u523A\u9634\u5E08\u8854\u63A5\u81F4\u8DD1\u504F\u987A\u85E4\u6478\u8FDE\u548C\u8C10\u8BFB\u8D77\u6765\u4E32\u516C\u7528\u7A33\u5316\u656C\u8C26\u4E86\u5C0A\u4E25\u695A\u56FE\u7406\u89C4\u5F8B\u79F0\u8F74\u9ED1\u767D\u5757\u6655\u7B14\u5947\u90E8\u66F2\u76F4\u6027\u6E29\u67D4\u5F00\u95ED\u7A97\u68C0\u67E5\u7EBF\u89D2\u7D20\u53E0\u5B58\u5F02\u73A9\u79FB\u65CB\u8DF3\u6837\u904D\u5386\u5565\u529F\u5143\u5C0F\u8BB0\u95F4\u6A61\u76AE\u6CE5\u5B57\u7AEF\u90BB\u5171\u65F6\u9488\u5224\u6293\u4F53\u5BA2\u7532\u641E\u7684\u79CD\u5C5E\u5957\u5A03\u9650\u4FE1\u606F\u5FFD\u7565\u7C7B\u9020\u5B50\u4E8C\u7CFB\u77DB\u76FE\u5305\u542B\u4EA4\u53C9\u5E94\u804C\u4E1A\u6750\u6599\u54C1\u94FE\u5730\u4E8B\u5BBE\u8C61\u5F81\u62AC\u6760\u7EA7\u8FA8\u6790\u573A\u8BBE\u4ECE\u67D0\u80AF\u786E\u9501\u7CD6\u846B\u82A6\u8D28\u4E09\u6BB5\u9879\u5468\u5EF6\u63D0\u6548\u8111\u5F31\u8BC1\u62C6\u6865\u6700\u53E6\u4ED6\u636E\u78B0\u677F\u9664\u6D1E\u4E22\u5165\u5D29\u584C\u89E3\u91CA\u628A\u5E38\u5706\u8D85\u8303\u56F4\u8BC4\u4EF7\u54EA\u4F3C\u9AA8\u67B6\u8C2C\u8BEF\u8BC6\u6ED1\u5761\u8BC9\u8BF8\u8EAB\u6743\u5A01\u9886\u57DF\u4F17\u8DDF\u98CE\u660E\u8001\u6F14\u5458\u4EE5\u74F7\u5373\u6781\u7BA1\u5FAA\u73AF\u7EDF\u8BA1\u9677\u9631\u5747\u767E\u57FA\u8C08\u7EC4\u590D\u5BB9\u65A5\u6734\u683C\u4E3A\u51FA\u505A\u7A81\u7834\u9009\u7701\u529B\u62D6\u4E94\u817F\u5219\u7EA6\u675F\u62C9\u5339\u65E5\u671F\u661F\u7B97\u5E74\u9F84\u96C6\u6C0F\u547D\u7B49\u6A21\u6001\u8D1F\u5FB7\u6469\u589E\u957F\u5355\u7387\u6CA1\u53BB\u6708\u7D27\u9694\u4E58\u79EF\u51CF\u6574\u8D21\u732E\u4E2A\u5347\u964D\u4F30\u500D\u51E0\u7FFB\u756A\u5E42\u5341\u9006\u54ED\u8D38\u6613\u8D5A\u94B1\u6069\u5C14\u5403\u5360\u4F4E\u5BCC\u5C3C\u5382\u6D88\u8D39\u56FD\u4EA7\u503C\u6C11\u7B2C\u519C\u6797\u6E14\u5DE5\u670D\u52A1\u8D44\u6295\u989D\u96F6\u552E\u652F\u6536\u540D\u9645\u53D8\u53D1\u5C55\u901F\u4F55\u7D2F\u5750\u7EFC\u9875\u4EBF\u5428\u65A4\u9877\u4EA9\u5E01\u622A\u5FEB\u5C3E\u4E13\u7279\u653E\u7F29\u80C6\u63D2\u5C45\u8DDD\u79BB\u4E0E\u6D53\u76D0\u601D\u4E8E\u5343\u514B\u6B65\u7CBE\u6562\u4FDD\u66F4\u59A5\u9500\u5E93\u503A\u5229\u6DA6\u81EA\u57CE\u9547\u5E02\u7B11\u533A\u8C03\u5931\u5F84\u7535\u8D27\u8FD0\u6C47\u50A8\u5907\u4F9B\u878D\u8FFD\u53CA\u9053\u8239\u8F66\u8F6E\u8349\u8FD8\u6253\u6263\u6EB6\u6DB2\u7A00\u8BA8\u5C49\u5C11\u5272\u52FE\u80A1\u7ACB\u9525\u7403\u56DB\u6D3E\u690D\u6811\u9635\u5C42\u949F\u4E03\u7ECF\u6D4E\u51FD\u61D2\u8D4B\u4F8B\u4EFD\u5883\u9E21\u5154\u7B3C\u76C8\u4E8F\u8861\u4F5C\u5B8C\u53D6\u5FD8\u6590\u6CE2\u5951\u9A97\u53E4\u5178\u72EC\u535A\u5F08\u7B80\u7EB3\u4EC0\u77ED\u4F18\u74F6\u9152\u5546\u722C\u5929\u9752\u86D9\u781D\u7801\u5236\u6CB3\u7B52\u68AF\u5300\u8FD4\u5F71\u6D82\u67D3\u62A5\u544A\u91D1\u65B0\u521B\u7EFF\u7ED9\u4FA7\u9769\u53CC\u4E61\u6751\u632F\u5174\u88D5\u4F9D\u5B89\u89C2\u6211\u7EF4\u62A4\u7262\u6389\u4F20\u5B66\u521D\u4F7F\u5BAA\u6D3B\u79D1\u5211\u7F6A\u653F\u5B98\u6848\u5BA1\u76D1\u5BDF\u8986\u76D6\u5784\u4F11\u8BD5\u53F8\u8D23\u4EFB\u5DF2\u5F52\u9F13\u52B1\u8457\u8FBE\u724C\u5904\u7F5A\u8BAE\u8BBC\u4E3E\u63F4\u52A9\u6696\u9884\u9632\u72AF\u6559\u80B2\u6280\u672F\u6BCD\u9EC4\u9A8C\u5BA4\u91CE\u68EE\u6E7F\u80BE\u5CF0\u6E90\u578B\u6D6A\u4FC3\u5E9F\u6C61\u6D77\u6D0B\u566A\u58F0\u6C14\u84DD\u78A7\u571F\u58E4\u51C0\u56ED\u4E45\u7530\u8015\u98DF\u8005\u82AF\u7247\u795E\u821F\u98DE\u7AD9\u5AE6\u5A25\u63A2\u7389\u795D\u6597\u5BFC\u822A\u673A\u90AE\u7231\u6E2F\u6FB3\u901A\u5DDD\u94C1\u4E16\u7EAA\u4E1C\u897F\u8F93\u667A\u4F26\u58A8\u6DF1\u6F5C\u594B\u8003\u94BB\u68A6\u6838\u805A\u63A7\u7A3B\u8881\u9686\u84BF\u5C60\u5466\u51A0\u75AB\u82D7\u514D\u536B\u533B\u7075\u9B42\u780D\u91C7\u60E0\u8BCA\u7597\u836F\u627F\u4F4F\u4ED7\u52BF\u526F\u4EAE\u534E\u558A\u704C\u516B\u5366\u8BB2\u5E7B\u5E9C\u7763\u969C\u8D22\u5584\u5BA3\u5A92\u77E9\u53C2\u4EAB\u56DE\u907F\u75DB\u9669\u5377\u529E\u8FA9\u53F2\u8109\u7EDC\u738B