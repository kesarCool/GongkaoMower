    characterSetSelectionMode: 7
    characterSequence: "\u5317\u4EAC\u70E4\u9E2D\u70B8\u9171\u9762\u6DAE\u7F8A\u8089\u8C46\u6C41\u513F\u7092\u809D\u5364\u716E\u706B\u70E7\u7206\u809A\u827E\u7A9D\u9A74\u6253\u6EDA\u8C4C\u9EC4\u82B8\u5377\u7CD6\u95E8\u9489\u997C\u82A5\u672B\u58A9\u7599\u7629\u704C\u80A0\u4E1D\u5473\u9EA6\u8921\u88E2\u874E\u5B50\u9EBB\u8150\u5E72\u4E38\u674F\u4EC1\u8001\u8336\u6C64\u72D7\u4E0D\u7406\u5305\u5341\u516B\u8857\u82B1\u8033\u6735\u773C\u7CD5\u714E\u679C\u9505\u5DF4\u83DC\u719F\u68A8\u6817\u8D34\u997D\u71AC\u5C0F\u9C7C\u5708\u7F7E\u8E66\u9CA4\u5927\u7897\u560E\u5929\u6D25\u635E\u72EC\u6D41\u918B\u91D1\u6BDB\u72EE\u8098\u67F4\u6C9F\u5821\u718F\u6CA7\u5DDE\u9E21\u767D\u7F69\u6B63\u5B9A\u5D29\u6912\u6E9C\u8170\u6539\u5200\u5357\u627F\u5FB7\u51C9\u7C89\u9979\u9987\u5BA3\u5316\u839C\u851A\u53BF\u5510\u5C71\u68CB\u79E6\u7687\u5C9B\u6872\u6924\u53F6\u90AF\u90F8\u62FD\u66F2\u5468\u6C38\u5E74\u4FDD\u6D0B\u6DC0\u54B8\u86CB\u5ECA\u574A\u9999\u6CB3\u77F3\u5BB6\u5E84\u7F38\u7089\u5E73\u6CC9\u725B\u76AE\u6E23\u9732\u69D0\u8302\u8FC1\u897F\u677F\u524A\u9065\u8FC7\u6CB9\u6258\u6832\u6833\u732B\u5254\u5C16\u9978\u592A\u8C37\u95FB\u559C\u539F\u5934\u8111\u6742\u5272\u6D51\u6E90\u7C73\u664B\u91AA\u7CDF\u67F3\u6797\u56E2\u6C81\u540C\u53F3\u7389\u8944\u84B8\u9B41\u6E05\u5F90\u6F5E\u57CE\u7529\u6C7E\u9633\u6838\u6843\u6252\u4E5D\u8F6C\u8471\u6D77\u53C2\u65CB\u6D4E\u628A\u9752\u6751\u5355\u70DF\u53F0\u7116\u6F4D\u671D\u535A\u9165\u961C\u6CF0\u4E09\u7F8E\u4E34\u6C82\u80F6\u4E1C\u9C85\u997A\u6DC4\u83CF\u6CFD\u58EE\u998D\u963F\u83B1\u829C\u5564\u9152\u80E1\u8FA3\u70E9\u9053\u53E3\u6D1B\u6C34\u5E2D\u6D46\u6761\u5F00\u5C01\u5757\u6876\u7119\u7261\u4E39\u71D5\u829D\u751F\u4FE1\u7096\u900D\u9547\u90D1\u5B89\u6241\u6FEE\u6B66\u6D89\u90CF\u8611\u83C7\u732A\u5730\u9C9C\u9178\u6BB5\u96EA\u7EF5\u6C99\u8FDE\u94C1\u9C7F\u8FB9\u9A6C\u6C88\u56DE\u9526\u629A\u987A\u62CC\u672C\u6EAA\u67B6\u5E2E\u9985\u5EF6\u5409\u51B7\u996D\u8840\u5E86\u5CAD\u6D3B\u957F\u6625\u8E44\u674E\u8D35\u56DB\u5154\u9ECF\u677E\u901A\u8461\u8404\u5F97\u83AB\u5229\u6740\u5217\u7EA2\u683C\u74E6\u65AF\u54C8\u5C14\u6EE8\u8138\u5751\u9F50\u6C5F\u7247\u4F0A\u84DD\u8393\u4E94\u5E38\u8FED\u51B0\u68CD\u4E71\u624B\u5168\u5976\u98CE\u8499\u53E4\u547C\u4F26\u8D1D\u5353\u8D44\u8D64\u5CF0\u5BF9\u5939\u8FBD\u835E\u9521\u76DF\u8349\u76D0\u87F9\u9F20\u9CDC\u626C\u76D6\u4E01\u5343\u5C42\u6865\u65E0\u6392\u9AA8\u6E56\u5965\u7076\u6F84\u95F8\u85CF\u4E66\u53EB\u76F1\u7719\u9F99\u867E\u6DEE\u8F6F\u515C\u82CF\u7CA5\u5761\u4E95\u5DDD\u5B81\u6CE2\u5706\u5609\u5174\u7CBD\u7ECD\u81ED\u534E\u817F\u6E29\u6867\u80DC\u5434\u8862\u821F\u5E26\u5949\u828B\u5D4A\u7B3C\u4E3D\u7F19\u4E91\u65A9\u5B9D\u58F3\u94B5\u9EB8\u814C\u7B03\u9E3F\u7AE0\u7B26\u79BB\u96C6\u9002\u4E00\u54C1\u95EE\u653F\u7B0B\u8D21\u9E45\u62C9\u548C\u4E3A\u5DE2\u94F6\u4EB3\u6CE1\u5BBF\u6492\u5BAB\u5A46\u62C5\u592B\u59BB\u80BA\u6284\u949F\u8D56\u751C\u5B9C\u5BBE\u71C3\u519B\u5C6F\u76D4\u5988\u5192\u4E50\u8DF7\u811A\u706F\u5F71\u81EA\u5403\u91CD\u65FA\u9ED4\u4E07\u5408\u78C1\u5668\u8282\u8110\u6A59\u6DAA\u9675\u69A8\u5A03\u7CEF\u604B\u7231\u96F7\u9075\u4E49\u52A1\u88F9\u5237\u7AF9\u6BD5\u5CA9\u70D9\u762A\u526A\u7EBF\u6C14\u5A01\u7802\u817E\u51B2\u6551\u9A7E\u4E73\u6247\u9975\u5EFA\u5C4F\u50A3\u91CE\u83CC\u9756\u7C91\u6CF8\u4F64\u65CF\u70C2\u53CC\u7248\u7EB3\u83E0\u841D\u666E\u6D31\u662D\u8305\u5241\u6C0F\u59CA\u59B9\u6E58\u5916\u5CB3\u6D1E\u5EAD\u6538\u90B5\u8861\u6D4F\u64C2\u6000\u82B7\u51E4\u51F0\u59DC\u76CA\u814A\u6C85\u82A6\u660C\u7F50\u85DC\u84BF\u676F\u5188\u5A7A\u6C7D\u83B2\u840D\u4E61\u4F59\u5F0B\u94C5\u70EB\u745E\u666F\u78B1\u798F\u4E30\u871C\u6854\u65B0\u660E\u70ED\u8116\u85D5\u7CCA\u6B22\u5768\u5B5D\u611F\u8346\u9996\u7B14\u6C94\u68A6\u6D2A\u6C49\u7965\u87E0\u6069\u65BD\u90E7\u53C9\u541E\u889C\u5496\u55B1\u4ED4\u7172\u907F\u5858\u8F66\u7FC5\u591A\u58EB\u5F0F\u631E\u4ECB\u4F11\u7403\u6728\u7CE0\u5E03\u975E\u6D32\u6FB3\u56FD\u514D\u6CBB\u86B5\u73CD\u73E0\u68FA\u6750\u9F0E\u5B97\u7CBF\u5207\u8247\u8C49\u722A\u6885\u6263\u5BA2\u917F\u869D\u9686\u9753\u7117\u5E7F\u6708\u87BA\u86F3\u6842\u53CB\u67E0\u6AAC\u68A7\u9F9F\u82D3\u818F\u8354\u6D66\u6A2A\u606D\u6714\u94A6\u866B\u9632\u6E2F\u7530\u8292\u5BB9\u67DA\u6587\u52A0\u79EF\u8865\u62B1\u7F57\u6930\u7B52\u9AD8\u5C4E\u85E4\u4F5B\u8DF3\u5899\u571F\u51BB\u86CE\u95FD\u6DA6\u8386\u53A6\u8584\u6F33\u5149\u81CA\u6CFC\u846B\u8D3E\u7511\u67FF\u5C90\u64C0\u4E2D\u76C6\u84FC\u6C47\u5EB7\u6986\u788E\u7CDC\u6F7C\u5173\u9655\u5170\u6293\u7070\u9185\u5471\u9647\u9759\u8FDC\u7F94\u5CEA\u6566\u714C\u5F20\u6396\u6413\u5957\u590F\u7518\u7266\u8D3A\u536B\u5FE0\u56FA\u67B8\u675E\u6C60\u6EE9\u7075\u67A3\u5FC3\u5634\u76D8\u4E32\u56CA\u5854\u5410\u9C81\u756A\u5BC6\u74DC\u5E93\u52D2\u514B\u82F9\u5580\u4EC0\u69B4\u5C15\u70AE\u4ED7\u7A1E\u7941\u8FBE\u7B4F\u5FAA\u7CCC\u4EBA\u6717\u8F9F\u6D74\u65E5\u5938\u7236\u8FFD\u7CBE\u586B\u540E\u7FBF\u5C04\u5AE6\u5A25\u5954\u5165\u4ED9\u753B\u70B9\u775B\u8863\u7F1D\u96FE\u6210\u8FD4\u8FD8\u7AE5\u79FB\u5012\u5524\u96E8\u795E\u51FA\u9B3C\u6CA1\u65A7\u5DE5\u59D1\u732E\u5BFF\u7FBD\u767B\u70BC\u9876\u7ACB\u5448\u98DE\u821E\u4E58\u5FEB\u5A7F\u9E4A\u76F8\u4F1A\u521A\u4F10\u87FE\u6298\u5982\u6BD4\u6851\u67EF\u5FD8\u5F52\u516D\u81C2\u53D8\u6500\u9644\u6F5C\u5728\u6E0A\u98D8\u6B32\u5E02\u8703\u697C\u90CE\u7EC7\u5973\u4E4C\u5546\u89C1\u62E8\u7535\u95EA\u9E23\u9A70\u63A3\u5389\u884C\u4E89\u864E\u6597\u6F6D\u7A74\u6DFB\u7FFC\u9E92\u9E9F\u4E4B\u624D\u5E8A\u5766\u8179\u6DF7\u6C8C\u521D\u7384\u4F0F\u7FB2\u5366\u771F\u7947\u7F51\u5760\u6709\u4E0A\u95F4\u743C\u5B87\u5347\u5171\u89E6\u5A32\u5E1D\u9E64\u53BB\u5947\u8C08\u6E38\u6D45\u8E1E\u8DC3\u5578\u541F\u9645\u5E7B\u58F0\u7476\u671B\u91CC\u6276\u503E\u9677\u547D\u989C\u60A6\u9706\u94A7\u59FF\u95F9\u4E03\u4E8C\u5723\u5175\u5C06\u5DEB\u86DF\u8D77\u5B88\u682A\u5F85\u523B\u6C42\u5251\u63A9\u76D7\u94C3\u63E0\u82D7\u52A9\u4EA1\u7262\u5F39\u7434\u5E95\u86D9\u72D0\u5047\u516C\u597D\u6EE5\u7AFD\u5145\u6570\u77DB\u76FE\u4E70\u691F\u5C65\u5B66\u6B65\u6548\u98A6\u8F95\u8F99\u5F13\u86C7\u8DB3\u9E6C\u868C\u87B3\u8782\u6355\u8749\u611A\u5FE7\u66AE\u76F2\u6478\u8C61\u56EB\u56F5\u5750\u89C2\u6280\u7A77\u56E0\u564E\u5E9F\u98DF\u6309\u56FE\u7D22\u9AA5\u7F18\u85AA\u996E\u9E29\u6B62\u6E34\u585E\u7FC1\u5931\u969C\u76EE\u591C\u5C3E\u7EED\u8C82\u72FC\u60CA\u9E1F\u72AC\u6295\u5FCC\u5507\u9F7F\u5BD2\u8F85\u4F9D\u91DC\u74EE\u9CD6\u6DB8\u9C8B\u7FA1\u6EF4\u7A7F\u6775\u9488\u5B5F\u6BCD\u65AD\u673A\u6559\u4EE5\u5375\u51FB\u73ED\u5F04\u8D3B\u7B11\u65B9\u7591\u90BB\u5BE1\u8D8A\u4FCE\u4EE3\u5E96\u89E3\u5F53\u5203\u6881\u541B\u542C\u9014\u8BF4\u6B67\u8DEF\u9965\u53F9\u670B\u72C8\u5978\u4F5C\u4F25\u9A71\u4E1B\u96C0\u8327\u7F1A\u58C1\u820D\u9010\u8FD1\u5DF1\u53D6\u6B7B\u8C8C\u504F\u6982\u7BA1\u7AA5\u800C\u8BBA\u7B54\u5BCC\u6240\u6B79\u6349\u6B83\u53CA\u66FE\u4F17\u94C4\u5367\u5C1D\u80C6\u7834\u6C89\u80CC\u6218\u695A\u6B4C\u5B8C\u74A7\u8D75\u8D1F\u8BF7\u7F6A\u9042\u8350\u7EB8\u6307\u9E7F\u7BDD\u8D27\u53EF\u5C45\u987E\u5E90\u8239\u501F\u7BAD\u601D\u8700\u4ECE\u620E\u97A0\u8EAC\u5C3D\u7601\u820C\u7FA4\u5112\u8BD7\u56ED\u7ED3\u4EE4\u7533\u56F4\u9B4F\u9000\u9F13\u518D\u8870\u7AED\u522E\u7597\u6BD2\u9738\u738B\u522B\u59EC\u5BB4\u9879\u6697\u5EA6\u9648\u4ED3\u7A7A\u8BA1\u57CB\u70FD\u620F\u8BF8\u4FAF\u8BFA\u5B63\u5315\u8155\u6377\u5148\u8BC6\u9C8D\u4EA4\u8C03\u64D2\u6545\u7EB5\u629B\u7816\u5F15\u62BD\u8131\u8D3C\u653B\u7792\u8D70\u7F6E\u767E\u6B86\u77E5\u5F7C\u5176\u5907\u9038\u52B3\u51FF\u5077\u60AC\u523A\u80A1\u62A5\u5F99\u5B57\u6765\u8109\u8C22\u548F\u69BB\u4FA7\u9A91\u4E3B\u610F\u6C9B\u8EAB\u66F9\u8425\u6A80\u5584\u80EF\u4E0B\u8FB1\u8427\u89C4\u968F\u7EA6\u6CD5\u711A\u7A0B\u97E9\u4FEE\u6808\u4E8B\u4FF1\u53EA\u6B20\u9891\u70E6\u5E08\u672A\u843D\u4E45\u67A5\u590D\u6D6A\u76F4\u6302\u5E06\u6DAF\u6D6E\u63A0\u6DE1\u5986\u6D53\u62B9\u8896\u4F73\u524D\u60C5\u96C1\u95ED\u7F9E\u8272\u7269\u662F\u7779\u4E3E\u6848\u7709\u745F\u9E3E\u5055\u6FE1\u6CAB\u656C\u5531\u5987\u955C\u5999\u6D8C\u94A9\u5206\u51E0\u4F55\u5FD7\u96BE\u916C\u9047\u9022\u65F6\u6211\u5883\u89C8\u8BFB\u80F8\u7BEE\u8A00\u7B80\u8D45\u6DF1\u810D\u7099\u4F20\u8BDD\u540D\u5782\u53F2\u7559\u82B3\u4E16\u501C\u50A5\u91C7\u6590\u7136\u8457\u7A88\u7A95\u6DD1\u9011\u8F97\u53CD\u8D24\u538C\u8BF2\u5026\u803B\u53D1\u6124\u901D\u8005\u663C\u593A\u903E\u77E9\u7EFF\u80A5\u7626\u5F84\u5E7D\u6CE5\u8721\u70AC\u6E14\u665A\u79CB\u971E\u5B64\u9E5C\u5F7B\u609F\u918D\u9190\u68D2\u559D\u8BAE\u7686\u6839\u51C0\u73B0\u5E78\u6052\u987D\u5370\u8D85\u51E1\u80CE\u6362\u68EE\u6781\u754C\u6148\u60B2\u529F\u91CF\u8574\u9972\u62C8\u4E25\u7167\u82E6\u52AB\u6EE1\u574F\u964D\u552F\u5C0A\u8F6E\u822A\u6027\u987F\u4ECA\u7537\u5E94\u7B49\u770B\u5C18\u573A\u6E21\u7F9A\u89D2\u6076\u622A\u5C3A\u7AFF\u67AF\u5CB8\u653E\u5C60\u9020\u7EA7\u5373\u865A\u5984\u83E9\u63D0\u6811\u4EA6\u5904\u60F9\u57C3\u52E4\u62C2\u62ED\u52FF\u4F7F\u72F1\u8C01\u80FD\u4FBF\u56F0\u7720\u54C9\u5F25\u9640\u79CD\u754F\u78E8\u5236\u8D81\u7275\u5C31\u7ECF\u72AF\u5411\u5B98\u4EFB\u7322\u72F2\u6563\u5F3A\u538B\u7684\u5C1A\u5FF5\u9664\u5146\u529B\u4E2A\u638C\u62CD\u54CD\u5320\u845B\u4EAE\u5356\u5F80\u4F4E\u9700\u786C\u82CD\u8747\u53EE\u987B\u7CFB\u4E8E\u6668\u4E8F\u5B9E\u728A\u6015\u8FD9\u7740\u90A3\u5230\u5FC5\u76B1\u72B6\u5143\u6613\u6731\u58A8\u9ED1\u4E86\u826F\u836F\u75C5\u9006\u5BF8\u9634\u5C11\u52AA\u5F92\u4F24\u62D4\u8BEF\u780D\u5DE7\u708A\u4E08\u6B64\u4E24\u517B\u7528\u867D\u810F\u64CD\u62DB\u904D\u9001\u793C\u8F7B\u5DF7\u82E5\u62D9\u667A\u5BA0\u614E\u7EC8\u59CB\u7D2F\u7978\u501A\u97F3\u5E0C\u5F62\u9532\u9542\u8DEC\u81F3\u9A84\u6BC5\u8BB7\u6D69\u7C7B\u8403\u517C\u60A3\u516E\u6BEB\u6062\u758F\u6F0F\u8FA9\u5824\u6E83\u8681\u5DF2\u7701\u4E4E\u4E5F\u539A\u7109\u5219\u7F54\u5915\u77E3\u8361\u621A\u5C81\u67CF\u51CB\u543E\u4F4D\u8C0B\u5FCD\u6DEB\u8D2B\u8D31\u5C48\u8F7D\u8986\u8BC8\u8C55\u7A81\u9063\u8FA8\u4F3C\u7EDD\u8E2A\u53EC\u5361\u5E01\u94BB\u7B93\uFF0C\u5151\u5185\u5177\u82F1\u96C4\u95EF\u83B7\u7A00\u9501\u6536\u8FDB\u9636\u5C40\u6D88\u8017\u5F55\u9897\u661F\u6B21\u7801\u5E76\u63A5\u5199\u578B\u4F53\u6267\u8DE8\u63A7\u4E0E\u4F8B\u671F\u6269\u5C55\u542F\u52A8\u5F02\u4EC5\u9A7B\u7531\u5B83\u903B\u8F91\u8BBE\u5FAE\u73AF\u57